{
  "name": "@klrohias/kekkai-rt-sdk",
  "version": "0.2.0",
  "description": "Modern Node.js SDK for the Kekkai Runtime sandbox service",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "author": {
    "name": "qingyiwebt",
    "url": "https://github.com/qingyiwebt"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "check": "tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm run build:test && node --test dist-test/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
